
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interactive Mathematics | Desmos</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #1e293b;
    }

    header {
      background: #17365d;
      color: white;
      padding: 28px 20px;
      text-align: center;
    }

    main {
      max-width: 1100px;
      margin: 30px auto;
      padding: 0 16px;
    }

    .calculator {
      background: white;
      padding: 16px;
      border-radius: 12px;
      box-shadow: 0 3px 12px #00000012;
    }

    iframe {
      display: block;
      width: 100%;
      height: 650px;
      border: 1px solid #ddd;
      border-radius: 6px;
    }

    footer {
      text-align: center;
      padding: 24px;
      color: #64748b;
    }

    @media (max-width: 600px) {
      iframe {
        height: 520px;
      }
    }
  </style>
</head>

<body>
  <header>
    <h1>Interactive Mathematics</h1>
    <p>Explore mathematics through Desmos</p>
  </header>

  <main>
    <h2>Cartesian Coordinate System</h2>
    <p>
      Explore points, coordinates, and graphs
      through this interactive activity.
    </p>

    <section class="calculator">
      <iframe
        src="https://www.desmos.com/calculator/9cdqrvv3dt?embed"
        title="Interactive Desmos Calculator"
        loading="lazy"
        allowfullscreen>
      </iframe>
    </section>
  </main>

  <footer>
    Interactive Mathematics | Powered by Desmos
  </footer>
</body>
</html>
